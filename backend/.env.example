# Cấu hình Cổng Backend Server (5050 tránh xung đột AirPlay port 5000 trên macOS)
PORT=5050

# Cấu hình MQTT Broker (khớp với mã nguồn ESP32)
MQTT_BROKER=mqtt://broker.hivemq.com:1883
TOPIC_SENSOR=ssdata
TOPIC_CONTROL=dvcontrol
TOPIC_RESPOND=dvrespond

# Cấu hình Cơ sở dữ liệu MySQL (XAMPP / MySQL Server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecoliving_iot

