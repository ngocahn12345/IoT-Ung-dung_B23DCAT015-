            "url": {
              "raw": "{{base_url}}/api/sensors/history?page=1&limit=10&type=ALL&status=ALL",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sensors",
                "history"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "type",
                  "value": "ALL",
                  "description": "ALL | TEMPERATURE | HUMIDITY | LIGHT | TIME"
                },
                {
                  "key": "status",
                  "value": "ALL",
                  "description": "ALL | NORMAL | WARNING | CRITICAL"
                },
                {
                  "key": "search",
                  "value": ">25",
                  "disabled": true,
                  "description": "Từ khóa, ngày (YYYY-MM-DD) hoặc so sánh (>28, <=70)"
                },
